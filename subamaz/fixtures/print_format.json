   "font_size": 14,
   "html": "<div style=\"padding:20px;font-family: sans-serif;\">\n<h2 style=\"border-bottom:2px solid #333;padding-bottom:8px;\">Vehicle Inspection Report — {{ doc.name }}</h2>\n<p><strong>Vehicle:</strong> {{ doc.vehicle }} &nbsp; <strong>Customer:</strong> {{ doc.customer or '' }} &nbsp; <strong>Date:</strong> {{ doc.inspection_date or '' }}</p>\n<p><strong>Inspector:</strong> {{ doc.inspector or '' }} &nbsp; <strong>Type:</strong> {{ doc.inspection_type or '' }} &nbsp; <strong>Mileage:</strong> {{ doc.mileage or '' }}</p>\n<hr>\n<table class=\"table table-bordered\" style=\"width:100%;border-collapse:collapse;\">\n<thead><tr><th>Section</th><th>Item</th><th>Result</th><th>Notes</th></tr></thead>\n<tbody>\n{% for row in doc.checklist %}\n<tr><td>{{ row.section }}</td><td>{{ row.checklist_item }}</td><td>{{ row.result }}</td><td>{{ row.notes or '' }}</td></tr>\n{% endfor %}\n</tbody>\n</table>\n<hr>\n<p><strong>Result:</strong> <span style=\"font-size:16px;\">{{ doc.inspection_result or 'N/A' }}</span> &nbsp; <strong>Recommendation:</strong> {{ doc.recommendation or 'N/A' }}</p>\n{% if doc.notes %}<div><strong>Notes:</strong> {{ doc.notes }}</div>{% endif %}\n<div style=\"margin-top:40px;display:flex;justify-content:space-between;\">\n<div>Inspector Signature: ______________________</div>\n<div>Date: {{ doc.inspection_date or '' }}</div>\n</div>\n</div>",
