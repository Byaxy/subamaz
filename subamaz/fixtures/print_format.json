    "font_size": 14,
    "html": "<div style=\"padding:20px;font-family: sans-serif;\">\n<h2>Quotation — {{ doc.name }}</h2>\n<p><strong>Customer:</strong> {{ doc.party_name or doc.customer_name or '' }} &nbsp; <strong>Date:</strong> {{ doc.transaction_date or '' }}</p>\n<p><strong>Company:</strong> {{ doc.company or '' }}</p>\n<hr>\n<table class=\"table table-bordered\" style=\"width:100%;border-collapse:collapse;\">\n<thead><tr><th>Item</th><th>Qty</th><th>Rate</th><th>Amount</th></tr></thead>\n<tbody>\n{% for row in doc.items %}\n<tr><td>{{ row.item_name or row.item_code }}</td><td>{{ row.qty }}</td><td>{{ row.rate }}</td><td>{{ row.amount }}</td></tr>\n{% endfor %}\n</tbody>\n</table>\n<hr>\n<p><strong>Total:</strong> {{ doc.grand_total or doc.total or '' }} {{ doc.currency or '' }}</p>\n<p>Generated from Service Order.</p>\n</div>",
