     "font_size": 14,
     "html": "<div style=\"padding:20px;font-family: sans-serif;\">\n<h2>Delivery Note — {{ doc.name }}</h2>\n<p><strong>Vehicle:</strong> {{ doc.vehicle }} &nbsp; <strong>Customer:</strong> {{ doc.customer }}</p>\n<p><strong>Service Order:</strong> {{ doc.service_order }} &nbsp; <strong>Date:</strong> {{ doc.delivery_date }}</p>\n<hr>\n<h3>Checklist</h3>\n<table class=\"table table-bordered\" style=\"width:100%;border-collapse:collapse;\">\n<thead><tr><th>Item</th><th>Done</th></tr></thead>\n<tbody>\n{% for row in doc.checklist %}\n<tr><td>{{ row.checklist_item }}</td><td>{{ 'Yes' if row.completed else 'No' }}</td></tr>\n{% endfor %}\n</tbody>\n</table>\n<h3>Photos</h3>\n{% for row in doc.photos %}\n<div><img src=\"{{ row.photo }}\" style=\"max-width:200px;\"/> {{ row.photo_type }}</div>\n{% endfor %}\n<div style=\"margin-top:40px;display:flex;justify-content:space-between;\">\n<div>Customer Signature: ______________________</div>\n<div>Staff Signature: ______________________</div>\n</div>\n</div>",
