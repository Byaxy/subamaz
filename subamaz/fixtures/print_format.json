     "doctype": "Print Format",
     "font_size": 14,
     "html": "<div style=\"padding:20px;font-family: sans-serif;\">\n<h2>Job Sheet — {{ doc.name }}</h2>\n<p><strong>Service Order:</strong> {{ doc.service_order }} &nbsp; <strong>Dept:</strong> {{ doc.department }} &nbsp; <strong>Technician:</strong> {{ doc.lead_technician }}</p>\n<p><strong>Status:</strong> {{ doc.status }} &nbsp; <strong>Priority:</strong> {{ doc.priority }}</p>\n<hr>\n<h3>Time Logs</h3>\n<table class=\"table table-bordered\" style=\"width:100%;border-collapse:collapse;\">\n<thead><tr><th>Technician</th><th>Started</th><th>Finished</th><th>Hours</th><th>Rate</th><th>Cost</th></tr></thead>\n<tbody>\n{% for row in doc.time_logs %}\n<tr><td>{{ row.technician }}</td><td>{{ row.started_at }}</td><td>{{ row.finished_at }}</td><td>{{ row.hours }}</td><td>{{ row.hourly_rate }}</td><td>{{ row.labour_cost }}</td></tr>\n{% endfor %}\n</tbody>\n</table>\n<h3>Consumed Parts</h3>\n<table class=\"table table-bordered\" style=\"width:100%;border-collapse:collapse;\">\n<thead><tr><th>Item</th><th>Qty</th><th>Rate</th><th>Amount</th><th>Stock Entry</th></tr></thead>\n<tbody>\n{% for row in doc.consumed_parts %}\n<tr><td>{{ row.item_code }}</td><td>{{ row.qty }}</td><td>{{ row.rate }}</td><td>{{ row.amount }}</td><td>{{ row.stock_entry or '' }}</td></tr>\n{% endfor %}\n</tbody>\n</table>\n<p><strong>Actual Hours:</strong> {{ doc.actual_hours }} &nbsp; <strong>Actual Cost:</strong> {{ doc.actual_cost }}</p>\n<div style=\"margin-top:40px;display:flex;justify-content:space-between;\">\n<div>Technician Signature: ______________________</div>\n<div>Supervisor Signature: ______________________</div>\n</div>\n</div>",
